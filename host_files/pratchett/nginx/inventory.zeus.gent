upstream homebox {
  server localhost:8299;
  keepalive 32;
}

server {
  listen 80;
  server_name inventory.zeus.gent;

  if ($request_method = GET) {
    return 301 https://inventory.zeus.gent$request_uri;
  }

  return 308 https://inventory.zeus.gent$request_uri;
}

server {
  listen 10443 ssl http2;
  server_name inventory.zeus.gent;

  ssl_certificate     /etc/ssl/private/fullchain.pem;
  ssl_certificate_key /etc/ssl/private/key.pem;
  include snippets/ssl_options_preload.conf;

  location / {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_read_timeout 86400;
    proxy_pass http://homebox;
  }
}
